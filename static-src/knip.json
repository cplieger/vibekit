{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["app.ts", "sw.ts", "**/*.test.ts", "**/*.fuzz.test.ts", "**/*.property.test.ts"],
  "project": ["**/*.ts", "!**/*.d.ts", "!node_modules/**"],
  "ignore": ["wire/*.gen.ts", "vitest.stryker.config.ts"],
  "ignoreDependencies": ["html-validate", "stylelint", "stylelint-config-standard"],
  "ignoreMembers": [
    "active",
    "addPendingPermission",
    "appendChunk",
    "appendMessage",
    "clearPendingPermissions",
    "dequeuePrompt",
    "element",
    "enqueuePrompt",
    "finalize",
    "getText",
    "isThinking",
    "loadList",
    "loadMessages",
    "removeChat",
    "removePendingPermission",
    "setActive",
    "setAvailableCommands",
    "setCurrentMode",
    "setThinking",
    "setWorkingLabel",
    "subscribe",
    "upsertHeader",
    "upsertMessage",
    "upsertToolCall"
  ],
  "treatConfigHintsAsErrors": true,
  "includeEntryExports": true,
  "typescript": {
    "config": ["tsconfig.json", "tsconfig.sw.json", "tsconfig.node.json"]
  },
  "ignoreIssues": {
    "smd.ts": ["exports", "types", "enumMembers", "namespaceMembers", "duplicates"],
    "actions/index.ts": ["exports", "types"],
    "types.ts": ["types"]
  }
}
