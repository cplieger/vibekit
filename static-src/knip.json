{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app.ts",
    "sw.ts",
    "theme-init.ts",
    "**/*.test.ts",
    "**/*.fuzz.test.ts",
    "**/*.property.test.ts"
  ],
  "project": ["**/*.ts", "!**/*.d.ts", "!node_modules/**"],
  "ignore": ["wire/*.gen.ts"],
  "paths": {
    "ansi_up": ["./test-stubs/ansi_up.ts"]
  },
  "ignoreDependencies": [
    "html-validate",
    "stylelint",
    "stylelint-config-standard"
  ],
  "ignoreBinaries": ["tsgo"],
  "ignoreMembers": [
    "active",
    "addPendingPermission",
    "appendChunk",
    "appendMessage",
    "clearPendingPermissions",
    "dequeuePrompt",
    "element",
    "enqueuePrompt",
    "finalize",
    "getText",
    "isThinking",
    "loadList",
    "loadMessages",
    "queuedPrompt",
    "removeChat",
    "removePendingPermission",
    "setActive",
    "setAvailableCommands",
    "setCurrentMode",
    "setQueuedPrompt",
    "setThinking",
    "setWorkingLabel",
    "subscribe",
    "upsertHeader",
    "upsertMessage",
    "upsertToolCall"
  ],
  "treatConfigHintsAsErrors": true,
  "includeEntryExports": true,
  "typescript": {
    "config": ["tsconfig.json", "tsconfig.sw.json", "tsconfig.node.json"]
  },
  "ignoreIssues": {
    "smd.ts": ["exports", "types", "enumMembers", "namespaceMembers", "duplicates"],
    "actions/index.ts": ["exports", "types"],
    "types.ts": ["types"]
  }
}
