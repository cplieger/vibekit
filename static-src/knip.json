{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app.ts",
    "sw.ts",
    "vitest.stryker.config.ts",
    "sse-worker.ts",
    "**/*.test.ts",
    "**/*.node.test.ts",
    "**/*.fuzz.test.ts",
    "**/*.property.test.ts"
  ],
  "project": ["**/*.ts", "!**/*.d.ts", "!node_modules/**"],
  "ignore": ["wire/*.gen.ts"],
  "ignoreDependencies": ["html-validate", "stylelint", "stylelint-config-standard"],
  "ignoreMembers": [
    "active",
    "addPendingPermission",
    "appendChunk",
    "appendMessage",
    "clearPendingPermissions",
    "dequeuePrompt",
    "element",
    "enqueuePrompt",
    "finalize",
    "getText",
    "isThinking",
    "loadList",
    "loadMessages",
    "removeChat",
    "removePendingPermission",
    "setActive",
    "setCurrentMode",
    "setThinking",
    "setWorkingLabel",
    "subscribe",
    "upsertHeader",
    "upsertMessage",
    "upsertToolCall"
  ],
  "treatConfigHintsAsErrors": true,
  "includeEntryExports": true,
  "tags": ["-@knipignore"],
  "typescript": {
    "config": ["tsconfig.json", "tsconfig.sw.json", "tsconfig.node.json"]
  },
  "ignoreIssues": {
    "smd.ts": ["exports", "types", "enumMembers", "namespaceMembers", "duplicates"],
    "actions/index.ts": ["exports", "types"],
    "icons.ts": ["duplicates"],
    "vitest.stryker.config.ts": ["exports"],
    "types.ts": ["types"]
  }
}
