{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    // tsc TYPECHECKS and never emits. Without this the compiler writes
    // unbundled per-module JS over `cmd/bundle`'s output (`outDir` used to say
    // `../static`) and the app dies in the browser on the first bare specifier
    // esbuild had resolved — so a green `npm run typecheck` broke the served
    // app. The Dockerfile's `--noEmit` flags were the workaround for its
    // absence; every sibling repo declares it here.
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false
  },
  "include": [
    "*.ts",
    "*.d.ts",
    "handlers/*.ts",
    "handlers/__test-helpers__/*.ts",
    "wire/*.ts",
    "actions/*.ts",
    "actions/__test-helpers__/*.ts",
    "__test-helpers__/*.ts",
    "lib/**/*.ts"
  ],
  "exclude": [
    "vitest.config.ts",
    "fc-strict-setup.ts",
    "**/*.test.ts",
    "**/*.fuzz.test.ts",
    "**/*.property.test.ts",
    "**/__test-helpers__/**"
  ]
}
